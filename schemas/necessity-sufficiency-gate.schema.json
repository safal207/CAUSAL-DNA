{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/CAUSAL-DNA/schemas/necessity-sufficiency-gate.schema.json",
  "title": "CAUSAL-DNA Necessity and Sufficiency Gate",
  "type": "object",
  "required": ["gate_id", "case_id", "gap_id", "cmg_ref", "gap_status", "causal_role_found", "outcome", "mediators"],
  "properties": {
    "gate_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "gap_id": {"type": "string", "minLength": 1},
    "cmg_ref": {"type": "string", "minLength": 1},
    "gap_status": {"type": "string", "enum": ["OPEN", "CLOSED"]},
    "causal_role_found": {"type": "boolean"},
    "outcome": {"type": "string", "minLength": 1},
    "mediators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "hypothesis_ref", "context", "declared_role",
          "necessity_test", "sufficiency_test",
          "residual_genotype_effect_after_block", "independent_verification"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "hypothesis_ref": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "declared_role": {
            "type": "string",
            "enum": [
              "UNRESOLVED", "NECESSITY_SUPPORTED", "SUFFICIENCY_SUPPORTED",
              "PARTIAL_MEDIATOR", "NECESSARY_NOT_SUFFICIENT",
              "SUFFICIENT_NOT_NECESSARY", "NECESSARY_PARTIALLY_SUFFICIENT",
              "NECESSARY_AND_SUFFICIENT", "NON_LOAD_BEARING"
            ]
          },
          "necessity_test": {
            "type": "object",
            "required": ["intervention", "outcome", "evidence_refs"],
            "properties": {
              "intervention": {"type": "string", "minLength": 1},
              "outcome": {"type": "string", "enum": ["not_tested", "no_change", "attenuated", "abolished"]},
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "sufficiency_test": {
            "type": "object",
            "required": ["intervention", "outcome", "evidence_refs"],
            "properties": {
              "intervention": {"type": "string", "minLength": 1},
              "outcome": {"type": "string", "enum": ["not_tested", "no_change", "partial", "recapitulated"]},
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "residual_genotype_effect_after_block": {
            "type": "string",
            "enum": ["not_tested", "absent", "present"]
          },
          "independent_verification": {
            "type": "object",
            "required": ["evidence_refs"],
            "properties": {
              "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
