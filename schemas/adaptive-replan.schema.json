{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/CAUSAL-DNA/schemas/adaptive-replan.schema.json",
  "title": "CAUSAL-DNA adaptive replanning scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "case_id", "simulation_only", "outcomes"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "simulation_only": {"const": true},
    "description": {"type": "string"},
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["generation", "experiment_id", "outcome_name", "simulation_only"],
        "properties": {
          "generation": {"type": "integer", "minimum": 2},
          "experiment_id": {"type": "string", "minLength": 1},
          "outcome_name": {"type": "string", "minLength": 1},
          "simulation_only": {"const": true},
          "note": {"type": "string"}
        }
      }
    }
  }
}
