{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/CAUSAL-DNA/schemas/strategy-config.schema.json",
  "title": "CAUSAL-DNA multi-step strategy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "case_id", "budget", "max_depth", "objective", "planning_only"],
  "properties": {
    "strategy_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "budget": {"type": "number", "exclusiveMinimum": 0},
    "max_depth": {"type": "integer", "minimum": 1, "maximum": 3},
    "objective": {"enum": ["information_gain", "gain_per_cost"]},
    "planning_only": {"const": true},
    "note": {"type": "string"}
  }
}
