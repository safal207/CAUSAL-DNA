{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/CAUSAL-DNA/schemas/distributional-robustness.schema.json",
  "title": "CAUSAL-DNA distributional robustness configuration",
  "type": "object",
  "required": [
    "analysis_id",
    "case_id",
    "disclaimer",
    "sensitivity_analysis_ref",
    "objective",
    "uncertainty_model",
    "outcome_probability_max_transfer",
    "assay_reliability_min",
    "assay_reliability_max",
    "cost_multiplier_min",
    "cost_multiplier_max",
    "max_baseline_first_step_cost",
    "include_stop"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "disclaimer": {"type": "string", "minLength": 1},
    "sensitivity_analysis_ref": {"type": "string", "minLength": 1},
    "objective": {"const": "information_gain_per_cost"},
    "uncertainty_model": {"const": "rectangular_interval"},
    "outcome_probability_max_transfer": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.5},
    "assay_reliability_min": {"type": "number", "minimum": 0, "maximum": 1},
    "assay_reliability_max": {"type": "number", "minimum": 0, "maximum": 1},
    "cost_multiplier_min": {"type": "number", "exclusiveMinimum": 0},
    "cost_multiplier_max": {"type": "number", "exclusiveMinimum": 0},
    "max_baseline_first_step_cost": {"type": "number", "exclusiveMinimum": 0},
    "include_stop": {"const": true}
  }
}
