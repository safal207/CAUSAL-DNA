{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/CAUSAL-DNA/schemas/causal-edge.schema.json",
  "title": "CAUSAL-DNA Causal Edge",
  "description": "Machine-readable representation of one proposed causal transition in a DNA-to-phenotype chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge_id",
    "from",
    "to",
    "claim",
    "context",
    "evidence_type",
    "sources",
    "confidence",
    "status",
    "alternative_explanations",
    "falsification_test"
  ],
  "properties": {
    "edge_id": {
      "type": "string",
      "pattern": "^CDNA-[0-9]{3}-E[0-9]{2,}$"
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "species": { "type": ["string", "null"] },
        "tissue": { "type": ["string", "null"] },
        "cell_type": { "type": ["string", "null"] },
        "sex": { "type": ["string", "null"] },
        "developmental_state": { "type": ["string", "null"] },
        "environment": { "type": ["string", "null"] }
      }
    },
    "evidence_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "association",
          "expression",
          "motif",
          "chromatin",
          "perturbation",
          "genome_editing",
          "rescue",
          "overexpression",
          "knockdown",
          "neuronal_inhibition",
          "functional",
          "in_vivo",
          "other"
        ]
      }
    },
    "intervention": {
      "type": ["string", "null"]
    },
    "outcome_measure": {
      "type": ["string", "null"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "url"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["PMID", "DOI", "dataset", "accession", "other"]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "moderate", "high"]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "supported",
        "perturbed",
        "rescued",
        "established",
        "rejected"
      ]
    },
    "alternative_explanations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "falsification_test": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
