{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/CAUSAL-DNA/schemas/experiment-plan.schema.json",
  "title": "CAUSAL-DNA Experiment Planning Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "case_id", "disclaimer", "hypotheses", "experiments"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "disclaimer": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "label", "cost", "outcomes"],
        "properties": {
          "experiment_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "cost": {"type": "number", "exclusiveMinimum": 0},
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "planning_probability", "posterior_weights"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "planning_probability": {"type": "number", "minimum": 0, "maximum": 1},
                "posterior_weights": {
                  "type": "object",
                  "minProperties": 2,
                  "additionalProperties": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        }
      }
    }
  }
}
